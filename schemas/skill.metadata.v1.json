{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skills-hub.bnbchain.org/schemas/skill.metadata.v1.json",
  "title": "Skill submission metadata (v1)",
  "description": "The contract a contributor-submitted skills/<name>-metadata.json must satisfy before enrichment. Validated in the low-privilege parse-pr job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["github_url", "category", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "github_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "category": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
